# Go sources and test fixtures stay LF on every OS (gofmt and the Code Studio LSP tests expect it).
*.go text eol=lf
go.mod text eol=lf
go.sum text eol=lf
# Shell scripts must stay LF: CRLF breaks them on Linux/macOS (shellcheck SC1017).
*.sh text eol=lf

# adOmnia ignore rules

# OS / editor
.DS_Store
.DS_Store?
._*
Thumbs.db
Desktop.ini
ehthumbs.db
.Spotlight-V100/
.Trashes/
.idea/
.vscode/
*.swp
*.swo
*~

# Local env / secrets
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.pfx
*.jks

# Logs and diagnostics
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
debug.log
trace.out
cpu.prof
mem.prof
coverage.html
coverage.txt

# Node / frontend generated output
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/.turbo/
frontend/.cache/
frontend/package.json.md5

# Go generated output
bin/
vendor/
*.test
*.out
go.work
go.work.sum

# Wails / packaged artifacts
build/bin/
build/dist/
build/*/bin/
build/*/dist/
dist/
release/

*.exe
*.exe~
*.dll
*.so
*.dylib
*.app/
*.dmg
*.deb
*.rpm
*.zip
*.tar.gz
*.tar.bz2
*.msi
*.upx.bak

# Local app data and temporary files
adomnia-data/
tmp/
temp/
*.tmp
*.bak
*.cache
*.db
*.sqlite

# Local assistant / scratch artifacts
.tokensave/
.claude/
.superpowers/


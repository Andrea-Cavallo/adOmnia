// Command server runs the __NAME__ gRPC service.
package main

import (
	"log/slog"
	"net"
	"os"
	"os/signal"
	"syscall"

	"google.golang.org/grpc"
	"google.golang.org/grpc/health"
	healthpb "google.golang.org/grpc/health/grpc_health_v1"
	"google.golang.org/grpc/reflection"
)

func main() {
	addr := os.Getenv("ADDR")
	if addr == "" {
		addr = ":50051"
	}
	listener, err := net.Listen("tcp", addr)
	if err != nil {
		slog.Error("listen failed", "err", err)
		os.Exit(1)
	}

	server := grpc.NewServer()
	healthServer := health.NewServer()
	healthpb.RegisterHealthServer(server, healthServer)
	// Reflection lets gRPC clients (grpcurl, adOmnia) discover the services.
	reflection.Register(server)
	// Register your services here once generated from proto/, e.g.
	// greeterv1.RegisterGreeterServiceServer(server, &greeter{})

	go func() {
		signals := make(chan os.Signal, 1)
		signal.Notify(signals, os.Interrupt, syscall.SIGTERM)
		<-signals
		healthServer.Shutdown()
		server.GracefulStop()
	}()

	slog.Info("listening", "addr", addr)
	if err := server.Serve(listener); err != nil {
		slog.Error("server failed", "err", err)
		os.Exit(1)
	}
}

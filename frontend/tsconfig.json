{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": [
      "ES2020",
      "ES2023.Array",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "*": [
        "./*"
      ],
      "@/*": [
        "./src/*"
      ],
      "emmet": [
        "./node_modules/emmet/dist/index.d.ts"
      ],
      "@onlook/models": [
        "./src/features/visual-editor/adapters/packages/models.ts"
      ],
      "@onlook/models/*": [
        "./src/features/visual-editor/vendor/packages/models/src/*/index.ts"
      ],
      "@onlook/utility": [
        "./src/features/visual-editor/adapters/packages/utility.ts"
      ],
      "@onlook/file-system": [
        "./src/features/visual-editor/adapters/packages/file-system.ts"
      ],
      "@onlook/constants": [
        "./src/features/visual-editor/vendor/packages/constants/src/index.ts"
      ],
      "@onlook/parser": [
        "./src/features/visual-editor/vendor/packages/parser/src/index.ts"
      ],
      "@onlook/penpal": [
        "./src/features/visual-editor/vendor/packages/penpal/src/index.ts"
      ],
      "@onlook/web-preload/*": [
        "./src/features/visual-editor/vendor/apps/web/preload/*"
      ],
      "@onlook/ui/tokens": [
        "./src/features/visual-editor/vendor/packages/ui/tokens.ts"
      ],
      "@onlook/ui/*": [
        "./src/features/visual-editor/adapters/ui/*.ts"
      ],
      "@ve-client/*": [
        "./src/features/visual-editor/vendor/apps/web/client/src/*"
      ]
    }
  },
  "include": [
    "src"
  ],
  "exclude": [
    "src/features/visual-editor/vendor/packages/parser/test"
  ]
}

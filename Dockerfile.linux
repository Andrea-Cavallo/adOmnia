# syntax=docker/dockerfile:1
#
# Produces a self-contained Linux AppImage that bundles WebKitGTK and all
# other shared library dependencies. Users need nothing installed.
#

FROM golang:1.27.3-bookworm@sha256:fea12ba16096adec0f699ce1c4da2154d320450e56c1f63671f95d2a3551c77b AS builder

ARG VERSION=dev
ARG GIT_COMMIT=unknown
ARG BUILD_DATE=unknown

ENV DEBIAN_FRONTEND=noninteractive
ENV CGO_ENABLED=1
ENV PATH="/go/bin:${PATH}"
# Run AppImage tools without FUSE (required inside Docker)
ENV APPIMAGE_EXTRACT_AND_RUN=1

# Debian package versions rotate with every security update; the base image tag already pins the release.
# hadolint ignore=DL3008
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl file gcc g++ git gnupg imagemagick \
    libayatana-appindicator3-dev libgtk-3-dev libwebkit2gtk-4.1-dev \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

# Fail a piped RUN when any stage of the pipe fails.
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# Node.js from the NodeSource apt repository, set up with the vendor's keyring method: the signing key is
# downloaded to a file, dearmored and referenced with signed-by, so apt verifies the package signatures and
# no downloaded script is executed. The repository path (node_20.x) pins the Node major.
# Debian package versions rotate with every security update; the NodeSource major (20.x) is the pin.
# hadolint ignore=DL3008
RUN mkdir -p /etc/apt/keyrings \
    && curl --proto '=https' --tlsv1.2 --max-redirs 3 -fsSL -o /tmp/nodesource.gpg.key \
        https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key \
    && gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg /tmp/nodesource.gpg.key \
    && rm /tmp/nodesource.gpg.key \
    && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_20.x nodistro main" \
        > /etc/apt/sources.list.d/nodesource.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# linuxdeploy bundles all .so deps (webkit, gtk, etc.) into the AppImage
RUN curl --proto '=https' --tlsv1.2 -fsSL -o /usr/local/bin/linuxdeploy \
        https://github.com/linuxdeploy/linuxdeploy/releases/download/continuous/linuxdeploy-x86_64.AppImage \
    && curl --proto '=https' --tlsv1.2 -fsSL -o /usr/local/bin/linuxdeploy-plugin-appimage \
        https://github.com/linuxdeploy/linuxdeploy-plugin-appimage/releases/download/continuous/linuxdeploy-plugin-appimage-x86_64.AppImage \
    && chmod +x /usr/local/bin/linuxdeploy /usr/local/bin/linuxdeploy-plugin-appimage

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY frontend/package*.json ./frontend/
WORKDIR /src/frontend
# `npm ci` installs exactly the committed lockfile; --ignore-scripts keeps dependency lifecycle scripts from
# running (esbuild/rolldown get their platform binary from optional dependencies, no script needed).
RUN npm ci --ignore-scripts
WORKDIR /src

COPY . .

RUN npm --prefix frontend run build && \
    mkdir -p build/bin && \
    go build -buildvcs=false -trimpath -tags 'production gtk3' \
      -ldflags "-s -w -X main.Version=${VERSION} -X main.BuildDate=${BUILD_DATE} -X main.GitCommit=${GIT_COMMIT}" \
      -o build/bin/adomnia .

RUN set -e && \
    mkdir -p /appdir/usr/bin \
             /appdir/usr/share/applications \
             /appdir/usr/share/icons/hicolor/256x256/apps && \
    cp build/bin/adomnia /appdir/usr/bin/adomnia && \
    chmod +x /appdir/usr/bin/adomnia && \
    if   [ -f assets/icons/linux/adOmnia_256x256.png ]; then \
        cp assets/icons/linux/adOmnia_256x256.png /appdir/usr/share/icons/hicolor/256x256/apps/adomnia.png; \
    elif [ -f build/appicon.png ]; then \
        convert build/appicon.png -resize 256x256 /appdir/usr/share/icons/hicolor/256x256/apps/adomnia.png; \
    fi && \
    if [ -f build/linux/adOmnia.desktop ]; then \
        sed -e 's|^Exec=.*|Exec=adomnia|' -e 's|^Icon=.*|Icon=adomnia|' \
            build/linux/adOmnia.desktop > /appdir/usr/share/applications/adomnia.desktop; \
    else \
        printf '[Desktop Entry]\nType=Application\nName=adOmnia\nExec=adomnia\nIcon=adomnia\nTerminal=false\nCategories=Development;Network;\n' \
            > /appdir/usr/share/applications/adomnia.desktop; \
    fi && \
    linuxdeploy --appdir /appdir --output appimage && \
    mkdir -p /out && \
    mv ./*.AppImage "/out/adOmnia-${VERSION}-linux-amd64.AppImage"

# Artifact-only image: it carries the AppImage file out of the build and is never run as a container.
# A numeric non-root USER keeps it safe if someone runs it anyway (no passwd file is needed for a uid).
FROM scratch AS artifact
USER 65534:65534
COPY --from=builder /out /

# syntax=docker/dockerfile:1
#
# Produces a self-contained Linux AppImage that bundles WebKitGTK and all
# other shared library dependencies. Users need nothing installed.
#

FROM golang:1.26.5-bookworm AS builder

ARG VERSION=dev
ARG GIT_COMMIT=unknown
ARG BUILD_DATE=unknown

ENV DEBIAN_FRONTEND=noninteractive
ENV CGO_ENABLED=1
ENV PATH="/go/bin:${PATH}"
# Run AppImage tools without FUSE (required inside Docker)
ENV APPIMAGE_EXTRACT_AND_RUN=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl file gcc g++ git imagemagick \
    libayatana-appindicator3-dev libgtk-3-dev libwebkit2gtk-4.1-dev \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# linuxdeploy bundles all .so deps (webkit, gtk, etc.) into the AppImage
RUN curl -fsSL -o /usr/local/bin/linuxdeploy \
        https://github.com/linuxdeploy/linuxdeploy/releases/download/continuous/linuxdeploy-x86_64.AppImage \
    && curl -fsSL -o /usr/local/bin/linuxdeploy-plugin-appimage \
        https://github.com/linuxdeploy/linuxdeploy-plugin-appimage/releases/download/continuous/linuxdeploy-plugin-appimage-x86_64.AppImage \
    && chmod +x /usr/local/bin/linuxdeploy /usr/local/bin/linuxdeploy-plugin-appimage

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY frontend/package*.json ./frontend/
RUN cd frontend && npm ci

COPY . .

RUN npm --prefix frontend run build && \
    mkdir -p build/bin && \
    go build -buildvcs=false -trimpath -tags 'production gtk3' \
      -ldflags "-s -w -X main.Version=${VERSION} -X main.BuildDate=${BUILD_DATE} -X main.GitCommit=${GIT_COMMIT}" \
      -o build/bin/adomnia .

RUN set -e && \
    mkdir -p /appdir/usr/bin \
             /appdir/usr/share/applications \
             /appdir/usr/share/icons/hicolor/256x256/apps && \
    cp build/bin/adomnia /appdir/usr/bin/adomnia && \
    chmod +x /appdir/usr/bin/adomnia && \
    if   [ -f assets/icons/linux/adOmnia_256x256.png ]; then \
        cp assets/icons/linux/adOmnia_256x256.png /appdir/usr/share/icons/hicolor/256x256/apps/adomnia.png; \
    elif [ -f build/appicon.png ]; then \
        convert build/appicon.png -resize 256x256 /appdir/usr/share/icons/hicolor/256x256/apps/adomnia.png; \
    fi && \
    if [ -f build/linux/adOmnia.desktop ]; then \
        sed -e 's|^Exec=.*|Exec=adomnia|' -e 's|^Icon=.*|Icon=adomnia|' \
            build/linux/adOmnia.desktop > /appdir/usr/share/applications/adomnia.desktop; \
    else \
        printf '[Desktop Entry]\nType=Application\nName=adOmnia\nExec=adomnia\nIcon=adomnia\nTerminal=false\nCategories=Development;Network;\n' \
            > /appdir/usr/share/applications/adomnia.desktop; \
    fi && \
    linuxdeploy --appdir /appdir --output appimage && \
    mkdir -p /out && \
    mv *.AppImage "/out/adOmnia-${VERSION}-linux-amd64.AppImage"

FROM scratch AS artifact
COPY --from=builder /out /

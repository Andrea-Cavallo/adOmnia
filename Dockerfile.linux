# syntax=docker/dockerfile:1

FROM golang:1.25-bookworm AS builder

ARG WAILS_VERSION=v2.12.0
ARG VERSION=dev
ARG GIT_COMMIT=unknown
ARG BUILD_DATE=unknown

ENV DEBIAN_FRONTEND=noninteractive
ENV CGO_ENABLED=1
ENV PATH="/go/bin:${PATH}"

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    file \
    gcc \
    g++ \
    git \
    imagemagick \
    libayatana-appindicator3-dev \
    libgtk-3-dev \
    libwebkit2gtk-4.0-dev \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

RUN go install github.com/wailsapp/wails/v2/cmd/wails@${WAILS_VERSION}

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY frontend/package*.json ./frontend/
RUN cd frontend && npm ci

COPY . .

RUN wails build \
    -clean \
    -platform linux/amd64 \
    -ldflags "-s -w -X main.Version=${VERSION} -X main.BuildDate=${BUILD_DATE} -X main.GitCommit=${GIT_COMMIT}"

RUN mkdir -p /out/package/icons && \
    cp build/bin/adOmnia /out/package/adOmnia && \
    chmod +x /out/package/adOmnia && \
    if [ -f build/linux/adOmnia.desktop ]; then cp build/linux/adOmnia.desktop /out/package/adOmnia.desktop; fi && \
    if [ -f build/linux/install.sh ]; then cp build/linux/install.sh /out/package/install.sh && chmod +x /out/package/install.sh; fi && \
    for size in 16 24 32 48 64 128 256 512; do \
      src="assets/icons/linux/adOmnia_${size}x${size}.png"; \
      if [ -f "$src" ]; then cp "$src" "/out/package/icons/"; fi; \
    done && \
    if [ -f assets/icons/linux/adOmnia_256x256.png ]; then cp assets/icons/linux/adOmnia_256x256.png /out/package/adOmnia.png; \
    elif [ -f build/appicon.png ]; then convert build/appicon.png -resize 256x256 /out/package/adOmnia.png; fi && \
    tar -czf "/out/adOmnia-${VERSION}-linux-amd64.tar.gz" -C /out/package . && \
    cp build/bin/adOmnia "/out/adOmnia-${VERSION}-linux-amd64"

FROM scratch AS artifact
COPY --from=builder /out /
